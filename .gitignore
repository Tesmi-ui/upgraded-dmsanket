# ============================================================================
# BRLF DMS — Git Ignore
# ============================================================================

# ── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
env/

# ── Node ───────────────────────────────────────────────────────────────────
node_modules/
frontend/build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── IDE ────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS ─────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── Environment & Secrets ─────────────────────────────────────────────────
.env
.env.local
.env.*.local

# ── Data (never commit user data) ─────────────────────────────────────────
data/uploads/
data/outputs/
data/backups/
data/logs/
data/inbox/*.xlsx
data/inbox/*.xls
data/inbox/*.csv
data/verified/
data/unverified/

# ── Docker ─────────────────────────────────────────────────────────────────
docker-compose.override.yml

# ── Testing ────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
