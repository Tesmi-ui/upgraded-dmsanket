# ============================================================================
# BRLF DMS — Environment Configuration
# ============================================================================
# Copy this file to .env and customise for your environment.
# Docker Compose will automatically pick up values from .env
# ============================================================================

# ── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ── Upload Limits ──────────────────────────────────────────────────────────
# Maximum upload file size in bytes (default: 100 MB)
MAX_UPLOAD_BYTES=104857600

# ── Column Configuration ──────────────────────────────────────────────────
# Change these to match your Excel headers
UNIQUE_KEY_COL=meta-instanceID
FARMER_NAME_COL=farmer_name
FATHER_SPOUSE_COL=father_spouse_name
SUBMISSION_DATE_COL=SubmissionDate
SURVEY_DATE_COL=date_of_survey

# ── API Configuration ─────────────────────────────────────────────────────
# Frontend API URL (used during React build)
REACT_APP_API_URL=http://localhost:8000

# ── Security ──────────────────────────────────────────────────────────────
# API key for authentication (leave empty to disable auth in dev mode)
BRLF_API_KEY=

# ── Logging ───────────────────────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ── Docker ─────────────────────────────────────────────────────────────────
# Number of gunicorn workers
WEB_CONCURRENCY=2
